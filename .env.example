# Copy to .env for Docker Compose. Keep this file private after adding a token.
# token (default) or none. none gives every reachable client full access.
# Only use none behind a trusted LAN firewall, never on a public endpoint.
DOWNKYI_AUTH_MODE=token
# In token mode an empty token generates /data/admin-token on first start.
DOWNKYI_ADMIN_TOKEN=
DOWNKYI_BIND=127.0.0.1
DOWNKYI_PORT=8511
# Initial default until a directory is saved in Web settings.
# Container path: /downloads (local bind), or an existing writable /export/... directory.
# Database and task locks must stay on the local /data bind, not NFS.
DOWNKYI_DOWNLOAD_DIR=/downloads
# Set to 1 only when the browser accesses the app through HTTPS.
DOWNKYI_SECURE_COOKIE=0
